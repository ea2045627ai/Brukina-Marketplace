# ==========================================================================
# BRUKINA ACCESS MARKETPLACE - MASTER GIT EXCLUSIONS PROFILE
# Path: .gitignore
# Prevents testing runtime artifacts and sensitive local keys from hitting GitHub.
# ==========================================================================

# Active Operational & Telephony Log Buffers
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Local Webhook Append-Only Event Store
.data/

# Diagnostic Reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Process Runtime Container Data
pids
*.pid
*.seed
*.pid.lock

# Instrument Coverage Registries
lib-cov
coverage
*.lcov
.nyc_output
.grunt
bower_components
.lock-wscript
build/Release

# Immutable Cloud Dependency Packages
node_modules/
jspm_packages/
web_modules/
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Tooling and Formatter Cache Footprints
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
.cache
.parcel-cache

# Environment Variable Storage Panels
.env
.env.*
!.env.example

# Next.js / Nuxt.js & Framework Complications
.next
out
.nuxt
.output
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test

# Vite Development and Hot-Reload Bundler Artifacts
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
