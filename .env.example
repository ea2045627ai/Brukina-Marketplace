# Configure this value in Netlify after a supply partner verifies the endpoint.
SUPPLY_PARTNER_WEBHOOK_URL=
# Optional SkillBridge-compatible partner endpoint. Takes precedence when set.
SKILLBRIDGE_WEBHOOK_URL=

# Required by the server-side order function. Never commit real values here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
WEBHOOK_SECRET=
# Backward-compatible name for Railway deployments.
RAILWAY_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# Arkesel server-side credentials. Never expose these in app.js.
TELEPHONY_PROVIDER_API_KEY=
TELEPHONY_PROVIDER_VOICE_URL=
ARKESEL_DEFAULT_PHONE=
