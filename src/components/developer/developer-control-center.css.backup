.developer-control-center {
  margin: 24px 0;
  padding: 20px;
  border: 2px solid #222;
  border-radius: 16px;
  background: #fff;
  color: #111;
  box-shadow: 0 8px 30px rgba(0,0,0,.08);
}

.developer-header,
.developer-status,
.developer-actions,
.developer-team {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

.developer-header {
  justify-content: space-between;
}

.developer-header h2 {
  margin: 0;
}

.developer-header p {
  margin: 5px 0 0;
  opacity: .7;
}

.developer-status {
  margin: 14px 0;
  padding: 10px;
  border-radius: 10px;
  background: #f3f3f3;
}

.developer-status span[data-developer-status="fixed"] {
  font-weight: 800;
}

.developer-team button.active {
  font-weight: 800;
  outline: 2px solid currentColor;
}

.developer-chat,
.developer-checklist,
.developer-feedback {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.developer-chat textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 100px;
  padding: 12px;
  border: 1px solid #bbb;
  border-radius: 10px;
  font: inherit;
}

.developer-actions button,
.developer-team button,
.developer-header button,
.developer-chat button,
.developer-control-center > button {
  padding: 9px 13px;
  border: 1px solid #aaa;
  border-radius: 9px;
  background: #f7f7f7;
  cursor: pointer;
}

.developer-checklist label {
  display: flex;
  gap: 8px;
  align-items: center;
  font-weight: 500;
}

.developer-feedback article {
  padding: 10px;
  border-left: 4px solid #777;
  background: #f7f7f7;
  border-radius: 6px;
}

.developer-feedback article[data-feedback-status="fixed"] {
  border-left-width: 6px;
  font-weight: 600;
}

.developer-feedback small {
  display: block;
  opacity: .6;
}

.developer-feedback p {
  margin: 5px 0 0;
}
